# ~/.config/ghostty/config
# macOS-specific options: macos-titlebar-style

# --- Theme -------------------------------------------------------------
theme = Kanagawa Wave

# --- Font --------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 14

# --- Background / opacity ----------------------------------------------
background-opacity = 1.0

# --- Cursor ------------------------------------------------------------
cursor-style = underline
cursor-style-blink = true

# --- Window / tabs -----------------------------------------------------
window-padding-x = 2
window-padding-y = 2
macos-titlebar-style = native
window-theme = ghostty

# --- Scrollback --------------------------------------------------------
scrollbar = system

# --- Shell / tmux integration ------------------------------------------
command = /bin/bash -c '~/.config/tmux/bootstrap.sh'
working-directory = ~

# Inherit cwd for new tabs/splits
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# --- Close behavior ----------------------------------------------------
confirm-close-surface = always
quit-after-last-window-closed = true

# --- Shell integration -------------------------------------------------
shell-integration-features = cursor,sudo,title

# --- Core Ghostty shortcuts --------------------------------------------
keybind = alt+enter=toggle_fullscreen
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+l=inspector:toggle
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+r=reload_config

# Font size
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# --- Unbind native tab/split bindings so tmux owns them ----------------
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+alt+up=unbind
keybind = ctrl+alt+down=unbind
keybind = ctrl+alt+left=unbind
keybind = ctrl+alt+right=unbind
