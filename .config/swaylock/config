ignore-empty-password
show-failed-attempts

clock
timestr=%H:%M:%S
datestr=%a, %d %b %Y

# Solid black background — no screenshots/blur to avoid OLED burn-in.
# Monitors stay connected (no DPMS power off) so kanshi never races.
color=000000

font=sans-serif
font-size=32

fade-in=0.15

indicator
indicator-radius=150
indicator-thickness=10
indicator-caps-lock

disable-caps-lock-text

separator-color=00000000

inside-color=00000088
inside-clear-color=ffd20400
inside-caps-lock-color=009ddc00
inside-ver-color=d9d8d800
inside-wrong-color=ee2e2400

ring-color=b7bdf8
ring-clear-color=f4dbd6
ring-caps-lock-color=f5a97f
ring-ver-color=8aadf4
ring-wrong-color=ee99a0

line-color=00000000
