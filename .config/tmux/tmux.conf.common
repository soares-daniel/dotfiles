# ~/.config/tmux/tmux.conf.common
# Shared tmux configuration — applies to both work and personal machines.

# --- Paths -------------------------------------------------------------
set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.config/tmux/plugins'

# --- Prefix ------------------------------------------------------------
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

# --- Basics ------------------------------------------------------------
set -g mouse on
set -g mode-keys vi
set -g status-keys vi
set -g history-limit 100000
set -g base-index 1
set -g pane-base-index 1
set -g renumber-windows on
set -g set-titles on
set -g automatic-rename on
set -g automatic-rename-format '#{pane_current_command}'

# --- Kanagawa Wave colors ----------------------------------------------
KANAGAWA_BG="#1F1F28"
KANAGAWA_BG_DARK="#16161D"
KANAGAWA_FG="#DCD7BA"
KANAGAWA_GRAY="#727169"
KANAGAWA_BLUE="#7E9CD8"
KANAGAWA_WHITE="#C8C093"

# --- Status bar (this is your "tab bar") -------------------------------
set -g status-position bottom
set -g status-style "bg=${KANAGAWA_BG_DARK},fg=${KANAGAWA_FG}"
set -g status-left-length 40
set -g status-right-length 100
set -g status-left "#[bg=${KANAGAWA_BLUE},fg=${KANAGAWA_BG},bold] #S #[bg=${KANAGAWA_BG_DARK},fg=${KANAGAWA_BLUE}] "
set -g status-right "#[fg=${KANAGAWA_GRAY}] #{battery_percentage} #{b:pane_current_path} %H:%M "
set -g window-status-format "#[bg=${KANAGAWA_GRAY},fg=${KANAGAWA_BG_DARK}] #I #[bg=${KANAGAWA_BG_DARK},fg=${KANAGAWA_FG}] #W "
set -g window-status-current-format "#[bg=${KANAGAWA_BLUE},fg=${KANAGAWA_BG},bold] #I #[bg=${KANAGAWA_BG_DARK},fg=${KANAGAWA_BLUE}] #W "
set -g window-status-separator ""

# --- Plugins -----------------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-battery'

# Resurrect / continuum settings
set -g @resurrect-dir '~/.config/tmux/resurrect'
set -g @resurrect-strategy-nvim 'session'
set -g @continuum-save-interval '15'
set -g @continuum-restore 'on'

# Auto-install TPM if missing
if "test ! -d ~/.config/tmux/plugins/tpm" \
   "run 'git clone https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm && ~/.config/tmux/plugins/tpm/bin/install_plugins'"

# Initialize TPM (plugins load here and may set their own bindings)
run '~/.config/tmux/plugins/tpm/tpm'

# --- Keybindings: sessions ---------------------------------------------
# These come after plugin load so they override plugin defaults.
# Both plain and Ctrl+ variants are bound so the prefix works whether Ctrl
# is released after Space or held for the following key.
bind s display-popup -E -w 60% -h 60% '~/.config/tmux/bin/tmux-switch-session-fzf'
bind C-s display-popup -E -w 60% -h 60% '~/.config/tmux/bin/tmux-switch-session-fzf'
bind f display-popup -E -w 60% -h 60% '~/.config/tmux/bin/tmux-new-project-fzf'
bind C-f display-popup -E -w 60% -h 60% '~/.config/tmux/bin/tmux-new-project-fzf'
bind \\ command-prompt -p "New session name:" "new-session -s '%%'"
bind C-\\ command-prompt -p "New session name:" "new-session -s '%%'"
bind x confirm-before -p "Kill session #S? (y/n)" kill-session
bind C-x confirm-before -p "Kill session #S? (y/n)" kill-session
bind ( switch-client -p
bind ) switch-client -n

# --- Keybindings: windows (tabs) ---------------------------------------
bind c new-window
bind C-c new-window
bind n next-window
bind C-n next-window
bind p previous-window
bind C-p previous-window
bind w choose-window
bind , command-prompt -I "#W" "rename-window '%%'"
bind & confirm-before -p "kill-window #W? (y/n)" kill-window

# --- Keybindings: panes ------------------------------------------------
bind v split-window -h -c "#{pane_current_path}"
bind C-v split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind C-_ split-window -v -c "#{pane_current_path}"
bind Left select-pane -L
bind Down select-pane -D
bind Up select-pane -U
bind Right select-pane -R
bind z resize-pane -Z
bind C-z resize-pane -Z
bind q confirm-before -p "kill-pane #P? (y/n)" kill-pane
bind C-q confirm-before -p "kill-pane #P? (y/n)" kill-pane

# --- Keybindings: copy mode --------------------------------------------
bind [ copy-mode
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel

# --- Keybindings: misc -------------------------------------------------
bind r source-file ~/.config/tmux/tmux.conf \; display-message "tmux config reloaded"
bind C-r source-file ~/.config/tmux/tmux.conf \; display-message "tmux config reloaded"
bind d detach-client
bind C-d detach-client
bind ? display-popup -E -w 80% -h 80% 'less ~/.config/tmux/CHEATSHEET.md'
