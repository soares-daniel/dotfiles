#!/usr/bin/env bash
set -euo pipefail

# Watch Sway output (hotplug) events and restart kanshi so it re-applies
# the correct profile. This handles dock disconnects that happen while the
# session is locked (swaylock) where kanshi might otherwise miss the event.
#
# We only restart kanshi if it is already active. This avoids a race with
# swayidle, which intentionally stops kanshi before DPMS-off.

while true; do
    # Block until an output event fires.
    if ! swaymsg -t subscribe '["output"]' >/dev/null 2>&1; then
        # Sway not running yet; back off and retry.
        sleep 5
        continue
    fi

    # Debounce: rapid-fire events often come in bursts (e.g. 5 in 7s
    # during a USB-C replug with DP-1 -> DP-2 port swap). Coalesce them
    # so we restart kanshi once per burst instead of hitting
    # systemd's start rate limiter (start-limit-hit).
    sleep 3

    # Recover a rate-limited kanshi. A burst of restarts can leave it in
    # failed (start-limit-hit); active-check alone would then ignore it
    # forever, leaving outputs on sway's fallback config.
    if systemctl --user is-failed --quiet kanshi.service 2>/dev/null; then
        systemctl --user reset-failed kanshi.service 2>/dev/null || true
        systemctl --user start kanshi.service 2>/dev/null || true
    # Only restart kanshi when it is already running. If swayidle has
    # intentionally stopped it for DPMS, leave it stopped.
    elif systemctl --user is-active --quiet kanshi.service 2>/dev/null; then
        # Clear the rate-limiter counter so a burst doesn't trip it.
        systemctl --user reset-failed kanshi.service 2>/dev/null || true
        systemctl --user restart kanshi.service
    fi
done
