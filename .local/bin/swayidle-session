#!/usr/bin/env bash
set -euo pipefail

# Ensure only one swayidle instance survives config reloads.
pkill -x swayidle || true

# Idle policy:
# - 2 min: lock session (swaylock, solid black + clock)
# - 5 min: stop kanshi, then DPMS power off monitors
#   Stopping kanshi BEFORE DPMS off prevents the race condition where
#   kanshi sees DPMS-off as a physical disconnect and misconfigures outputs.
#   On resume, kanshi is restarted after monitors are back so it sees the
#   full setup and applies the correct profile cleanly.
# - 10 min: suspend (battery only)
# - before-sleep: always lock
exec swayidle -w \
  timeout 120 'swaylock -f' \
  timeout 300 'systemctl --user stop kanshi.service; swaymsg "output * power off"' \
  resume 'swaymsg "output * power on" && for i in 1 2 3; do sleep 2 && systemctl --user start kanshi.service && break; done && sway-fix-aws-vpn' \
  timeout 600 '~/.local/bin/sway-suspend-if-not-ac' \
  before-sleep 'swaylock -f'